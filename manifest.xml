<?xml version="1.0" encoding="utf-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xsi:type="MailApp">
  <Id>331421de-d503-4060-9eb3-ffede16599fd</Id>
  <Version>1.2.0.0</Version>
  <ProviderName>RINKT</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Email Validator"/>
  <Description DefaultValue="Automatically validates recipient email addresses"/>
  <IconUrl DefaultValue="https://vasi25.github.io/outlook_email_validator/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://vasi25.github.io/outlook_email_validator/icon-128.png"/>
  <SupportUrl DefaultValue="https://github.com/vasi25/outlook_email_validator"/>
  <AppDomains>
    <AppDomain>https://vasi25.github.io</AppDomain>
    <AppDomain>https://vasilocaladdin:3000</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.10"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemEdit">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://vasi25.github.io/outlook_email_validator/commands.html"/>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadWriteItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Edit"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides/1.1" xsi:type="VersionOverridesV1_1">
      <Requirements>
        <bt:Sets DefaultMinVersion="1.10">
          <bt:Set Name="Mailbox"/>
        </bt:Sets>
      </Requirements>
      <Hosts>
        <Host xsi:type="MailHost">
          <Runtimes>
            <Runtime resid="WebViewRuntime.Url">
              <Override type="javascript" resid="JSRuntime.Url"/>
            </Runtime>
          </Runtimes>
          <DesktopFormFactor>
            <FunctionFile resid="Commands.Url"/>
            <ExtensionPoint xsi:type="LaunchEvent">
              <LaunchEvents>
                <LaunchEvent Type="OnNewMessageCompose" FunctionName="onMessageComposeHandler" SendMode="PromptUser"/>
              </LaunchEvents>
              <SourceLocation resid="WebViewRuntime.Url"/>
            </ExtensionPoint>
          </DesktopFormFactor>
        </Host>
      </Hosts>
      <Resources>
        <bt:Images>
          <bt:Image id="Icon.16x16" DefaultValue="https://vasi25.github.io/outlook_email_validator/icon-16.png"/>
          <bt:Image id="Icon.32x32" DefaultValue="https://vasi25.github.io/outlook_email_validator/icon-32.png"/>
          <bt:Image id="Icon.80x80" DefaultValue="https://vasi25.github.io/outlook_email_validator/icon-80.png"/>
        </bt:Images>
        <bt:Urls>
          <bt:Url id="Commands.Url" DefaultValue="https://vasi25.github.io/outlook_email_validator/commands.html"/>
          <bt:Url id="WebViewRuntime.Url" DefaultValue="https://vasi25.github.io/outlook_email_validator/commands.html"/>
          <bt:Url id="JSRuntime.Url" DefaultValue="https://vasi25.github.io/outlook_email_validator/commands.js"/>
        </bt:Urls>
        <bt:ShortStrings>
          <bt:String id="GroupLabel" DefaultValue="Email Validator"/>
        </bt:ShortStrings>
        <bt:LongStrings>
        </bt:LongStrings>
      </Resources>
    </VersionOverrides>
  </VersionOverrides>
</OfficeApp>
